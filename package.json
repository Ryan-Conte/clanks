{
  "name": "clanks",
  "private": true,
  "description": "Put the clankers to work: a desktop crew of AI agents that runs on your own machine.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm fetch-llama && pnpm --filter @clanks/desktop dev",
    "build": "turbo run build",
    "package": "pnpm fetch-llama && pnpm --filter @clanks/desktop package",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @clanks/models test:e2e",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @clanks/orchestrator db:generate",
    "marketplace": "pnpm --filter @clanks/orchestrator marketplace",
    "fetch-llama": "pnpm --filter @clanks/models fetch-llama"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.0.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
