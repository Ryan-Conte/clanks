---
import { NAV } from '../lib/site';
import Logo from './Logo.astro';
---

<header class="relative z-20 mx-auto flex max-w-6xl items-center justify-between gap-6 px-4 py-5 sm:px-6">
  <a href="/" class="flex items-center gap-2.5 rounded-lg" aria-label="clanks home">
    <Logo />
    <span class="text-[17px] font-semibold tracking-tight">clanks</span>
  </a>
  <nav aria-label="Main" class="hidden items-center gap-7 text-sm text-dim md:flex">
    {NAV.map((item) => (
      <a href={item.href} class="transition-colors hover:text-white">
        {item.label}
      </a>
    ))}
  </nav>
  <a
    href="/#download"
    class="rounded-full bg-white px-4 py-2 text-sm font-medium text-black transition-colors hover:bg-white/85"
  >
    Download
  </a>
</header>
