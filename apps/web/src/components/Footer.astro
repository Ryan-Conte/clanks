---
import { MARKETPLACE, REPO } from '../lib/site';
import Logo from './Logo.astro';

const links = [
  { label: 'Docs', href: '/docs/' },
  { label: 'GitHub', href: REPO },
  { label: 'Marketplace', href: MARKETPLACE },
  { label: 'Apache-2.0', href: `${REPO}/blob/main/LICENSE` },
];
---

<footer class="relative z-10 mx-auto flex max-w-6xl flex-col items-center justify-between gap-5 border-t border-line px-4 py-8 text-sm text-dim sm:flex-row sm:px-6">
  <a href="/" class="flex items-center gap-2.5 text-white">
    <Logo size="sm" />
    clanks
  </a>
  <nav aria-label="Footer" class="flex flex-wrap justify-center gap-x-6 gap-y-2">
    {links.map((link) => (
      <a href={link.href} class="transition-colors hover:text-white">
        {link.label}
      </a>
    ))}
  </nav>
  <span>Built by humans. Run by clankers.</span>
</footer>
