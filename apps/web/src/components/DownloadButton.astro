---
import { DOWNLOADS } from '../lib/site';

/**
 * The main download button. It's rendered for macOS, and the download script switches it to the
 * reader's computer from the links it carries.
 */
interface Props {
  size?: 'md' | 'lg';
}
const { size = 'lg' } = Astro.props;
const [mac] = DOWNLOADS;
const data = Object.fromEntries(
  DOWNLOADS.flatMap((d) => [
    [`data-${d.platform}-href`, d.href],
    [`data-${d.platform}-name`, d.name],
  ]),
);
---

<a
  href={mac?.href}
  data-download
  {...data}
  class:list={[
    'inline-flex items-center justify-center gap-2.5 rounded-full bg-white font-medium text-black transition-colors hover:bg-white/85',
    size === 'lg' ? 'h-12 px-6 text-sm' : 'h-9 px-4 text-[13px]',
  ]}
>
  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path
      d="M8 2v8m0 0L4.5 6.5M8 10l3.5-3.5M3 13h10"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
  </svg>
  <span>
    Download for <span data-download-name>{mac?.name}</span>
  </span>
</a>
