---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { GUIDE_ORDER, REPO } from '../../lib/site';

interface Guide {
  /** The path under /docs/: empty for the README. */
  slug: string;
  /** Its first heading. */
  title: string;
  entry: CollectionEntry<'guide'>;
}

export async function getStaticPaths() {
  const rank = (slug: string) =>
    slug === '' ? -1 : GUIDE_ORDER.indexOf(slug) + 1 || GUIDE_ORDER.length + 1;
  const all: Guide[] = (await getCollection('guide'))
    .map((entry) => ({
      slug: entry.id === 'readme' ? '' : entry.id,
      title: /^#\s+(.+)$/m.exec(entry.body ?? '')?.[1]?.trim() ?? entry.id,
      entry,
    }))
    .sort((a, b) => rank(a.slug) - rank(b.slug));
  return all.map((guide) => ({
    params: { slug: guide.slug || undefined },
    props: { guide, all },
  }));
}

interface Props {
  guide: Guide;
  all: Guide[];
}

const { guide, all } = Astro.props;
const { Content } = await render(guide.entry);
const index = all.findIndex((g) => g.slug === guide.slug);
const next = all[index + 1];
const href = (g: Guide) => (g.slug ? `/docs/${g.slug}/` : '/docs/');
const source = `${REPO}/blob/main/docs/guide/${guide.slug || 'README'}.md`;
---

<Base title={guide.slug ? guide.title : 'Docs'}>
  <div class="relative z-10 mx-auto grid max-w-6xl gap-10 px-4 pt-10 pb-24 sm:px-6 md:grid-cols-[13rem_1fr] md:pt-16">
    <nav aria-label="Guides" class="md:sticky md:top-8 md:self-start">
      <p class="mb-3 px-3 font-mono text-xs tracking-[0.2em] text-accent uppercase">Docs</p>
      <ul class="flex gap-1 overflow-x-auto pb-2 md:flex-col md:overflow-visible md:pb-0">
        {all.map((g) => (
          <li class="shrink-0">
            <a
              href={href(g)}
              aria-current={g.slug === guide.slug ? 'page' : undefined}
              class="block rounded-lg px-3 py-1.5 text-sm whitespace-nowrap text-dim transition-colors hover:text-white aria-[current=page]:bg-white/[0.06] aria-[current=page]:text-white"
            >
              {g.slug ? g.title : 'Overview'}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <article class="min-w-0 max-w-3xl">
      <div class="prose">
        <Content />
      </div>
      <div class="mt-16 flex flex-col gap-4 border-t border-line pt-6 text-sm sm:flex-row sm:items-center sm:justify-between">
        <a href={source} class="text-dim transition-colors hover:text-white">
          Edit this page on GitHub
        </a>
        {next && (
          <a
            href={href(next)}
            class="rounded-full border border-line bg-white/5 px-4 py-2 transition-colors hover:bg-white/10"
          >
            Next: {next.title} →
          </a>
        )}
      </div>
    </article>
  </div>
</Base>
